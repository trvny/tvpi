{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tvpi",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Global last-known-good store (L3a). The Polish residential pusher writes
  // fresh URLs here through /push; request-time resolution only reads them.
  // D1's free tier leaves ample room for the nine-channel push cadence.
  // Read-path freshness is enforced in code (LKG_MAX_AGE_MS), since D1 has no
  // native TTL. DB created + migration 0001 applied to the remote already.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tvpi-lkg",
      "database_id": "2bb79e21-9133-4889-8761-1eedd561cee3",
      "migrations_dir": "migrations"
    }
  ],

  // Manifest and playlist mirror written by the residential pusher. R2 keeps
  // the latest pushed material available independently of the git mirror.
  "r2_buckets": [
    { "binding": "MIRROR", "bucket_name": "tvpi-mirror" }
  ],

  // An explicit empty list removes the already-deployed */20 schedule.
  // Residential push is the writer; TVP Info can still resolve live on request.
  "triggers": {
    "crons": [0 */2 * * *]
  },

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 0.01 }
  }
}
